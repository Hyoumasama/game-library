{
  "name": "game-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "watch:match": "node --env-file=.env.local --experimental-strip-types --import ./scripts/watch/node-loader.mjs scripts/watch/matchImportItem.ts",
    "hltb:backfill": "node --env-file=.env.local --experimental-strip-types --import ./scripts/watch/node-loader.mjs scripts/backfill-hltb.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/watch/node-loader.mjs --import ./tests/core/setup.mjs --test --test-isolation=none tests/core/*.test.mjs",
    "awards:fetch": "node scripts/awards/fetch-history.mjs",
    "awards:import": "node --env-file=.env.local --experimental-strip-types scripts/awards/import.mjs",
    "awards:test": "node --experimental-strip-types --test --test-isolation=none tests/awards/*.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "@types/papaparse": "^5.5.2",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "cheerio": "1.2.0",
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.64.0"
  }
}
