{
  "name": "game-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "watch:match-preview": "node --experimental-strip-types --experimental-transform-types --import ./scripts/watch/node-loader.mjs scripts/watch/buildMatchReview.ts",
    "watch:build-holdings": "node --experimental-strip-types --experimental-transform-types scripts/watch/buildLocalHoldings.ts",
    "watch:import-items": "node --experimental-strip-types --experimental-transform-types scripts/watch/importWatchItems.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/watch/node-loader.mjs --test --test-isolation=none tests/relationships/*.test.mjs",
    "relationships:preview": "node scripts/relationships/backfill.mjs",
    "relationships:backfill": "node scripts/relationships/backfill.mjs --apply",
    "relationships:enrich-preview": "node scripts/relationships/enrich.mjs",
    "relationships:enrich": "node scripts/relationships/enrich.mjs --apply",
    "relationships:report": "node scripts/relationships/report.mjs",
    "test:relationships:smoke": "node --experimental-strip-types --import ./scripts/watch/node-loader.mjs tests/relationships/smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@types/papaparse": "^5.5.2",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
